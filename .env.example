# Copie para .env e preencha:  cp .env.example .env

# Provedor do modelo: anthropic | openrouter
PROVIDER=openrouter

# ID do modelo no provedor escolhido. Exemplos:
#   anthropic  -> claude-haiku-5-5 (desenvolvimento) | claude-sonnet-5-5 (conversas finais)
#   openrouter -> qualquer modelo com suporte a tool calling (ex.: um modelo com sufixo :free)
MODEL_ID=

# Preencha só a chave do provedor escolhido
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Parâmetros de geração
TEMPERATURE=0.2
MAX_TOKENS=1024

# Data de referência simulada (AAAA-MM-DD), próxima ao último pedido da base.
# Ver docs/decisoes.md, S01.
REFERENCE_DATE=2026-03-25

# Banco SQLite gerado pelo ETL
DB_PATH=data/emporio.db
